#include <stdio.h>
 
int main() {
 
    int N;
    scanf("%i", &N);
   
    for (int i = 0; i < N; i++){
        
        int sdk[9][9];
            int linha=0, coluna=0;

        for(int j = 0; j < 9; j++){
            for(int k = 0; k < 9; k++){
                scanf("%i", &sdk[j][k]);
                linha += sdk[j][k];
            }
            coluna += sdk[j][k];
        }

        printf("%i %i", linha, coluna);
    
    
    
    }  
    return 0;
}
